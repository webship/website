{
    "name": "drupal/website",
    "description": "Website: a ready-to-use Drupal project, installed with the Webship installer and one of its site templates: Website Starter, Webship Starter, Webship Portal, Drupal Website API Starter or Webships API Starter. Built with the UI Suite UIkit theme (UIkit and HTMX) on top of Drupal and Display Builder.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/website",
    "support": {
        "docs": "https://www.drupal.org/project/website",
        "issues": "https://www.drupal.org/project/issues/website"
    },
    "repositories": {
        "swagger-ui": {
            "type": "package",
            "package": {
                "name": "swagger-api/swagger-ui",
                "version": "5.33.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/swagger-api/swagger-ui/archive/refs/tags/v5.33.0.zip",
                    "type": "zip"
                }
            }
        },
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "^2.3",
        "drupal/core-composer-scaffold": "^11.4 || ^12",
        "drupal/core-project-message": "^11.4 || ^12",
        "drupal/core-recipe-unpack": "^11.4 || ^12",
        "drupal/core-recommended": "^11.4 || ^12",
        "drupal/core-vendor-hardening": "^11.4 || ^12",
        "drupal/webapi_starter": "2.0.x-dev",
        "drupal/webpatches": "12.0.x-dev",
        "drupal/webship_portal": "1.0.x-dev",
        "drupal/webship_starter": "1.0.x-dev",
        "drupal/webships_starter": "2.0.x-dev",
        "drupal/website_starter": "1.0.x-dev",
        "mglaman/composer-drupal-lenient": "^2.0",
        "webship/patches": "12.0.x-dev",
        "webship/webship": "12.0.x-dev"
    },
    "require-dev": {
        "drush/drush": "^13.7 || ^14"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": false,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "symfony/runtime": true,
            "tbachert/spi": false,
            "webship/patches": true
        },
        "bin-dir": "vendor/bin",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/example.gitignore": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-recipe-unpack": {
            "ignore": [
                "drupal/webapi_starter",
                "drupal/webship_portal",
                "drupal/webship_starter",
                "drupal/webships_starter",
                "drupal/website_starter"
            ]
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                    </>",
                "<bg=blue;fg=white>  Congratulations, your Website project is ready!   </>",
                "<bg=blue;fg=white>                                                    </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Start DDEV: ddev start",
                "  * Install in the browser: ddev launch (the Webship installer lists the site templates)",
                "  * Or from the command line: ddev drush site:install webship -y",
                "  * Build pages with Display Builder: /admin/structure/page-layout"
            ]
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patches-ignore": {
            "webship/patches": {
                "drupal/display_builder": {
                    "fix: #3623215 Store the schema types of values saved from the Config panel": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/display_builder--2026-09-15--3623215--mr-401--1-0-0-beta7.patch"
                }
            }
        },
        "patches": {
            "drupal/display_builder": {
                "fix: #3623215 Store the schema types of values saved from the Config panel": "https://raw.githubusercontent.com/webship/patches/refs/heads/patches/display_builder--2026-09-28--3623215--mr-401--1-0-0-beta8.patch"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/ai",
                "drupal/ai_agents",
                "drupal/ai_assistant_api",
                "drupal/ai_chatbot",
                "drupal/ai_content_suggestions",
                "drupal/ai_image_alt_text",
                "drupal/ai_logging",
                "drupal/ai_penpot",
                "drupal/ai_playwright",
                "drupal/ai_provider_anthropic",
                "drupal/ai_provider_huggingface",
                "drupal/ai_provider_ollama",
                "drupal/ai_provider_openai",
                "drupal/ai_provider_xai",
                "drupal/ai_translate",
                "drupal/antibot",
                "drupal/autocomplete_deluxe",
                "drupal/automatic_updates",
                "drupal/better_exposed_filters",
                "drupal/captcha",
                "drupal/coffee",
                "drupal/config_filter",
                "drupal/config_ignore",
                "drupal/config_import_single",
                "drupal/config_rewrite",
                "drupal/config_split",
                "drupal/config_update",
                "drupal/config_update_ui",
                "drupal/consumers",
                "drupal/crop",
                "drupal/ctools",
                "drupal/dashboards",
                "drupal/display_builder",
                "drupal/display_builder_entity_view",
                "drupal/display_builder_page_layout",
                "drupal/display_builder_ui",
                "drupal/display_builder_views",
                "drupal/drupical",
                "drupal/easy_breadcrumb",
                "drupal/easy_encryption",
                "drupal/editor_advanced_link",
                "drupal/embed",
                "drupal/entity_embed",
                "drupal/field_group",
                "drupal/field_validation",
                "drupal/flood_control",
                "drupal/focal_point",
                "drupal/friendlycaptcha",
                "drupal/gemini_provider",
                "drupal/google_analytics",
                "drupal/google_tag",
                "drupal/honeypot",
                "drupal/inline_entity_form",
                "drupal/jsonapi_extras",
                "drupal/key",
                "drupal/klaro",
                "drupal/login_emailusername",
                "drupal/manage_display",
                "drupal/media_directories_editor",
                "drupal/media_directories_ui",
                "drupal/media_remote_audio",
                "drupal/media_remote_image",
                "drupal/metatag",
                "drupal/openapi",
                "drupal/openapi_jsonapi",
                "drupal/openapi_rest",
                "drupal/openapi_ui",
                "drupal/openapi_ui_swagger",
                "drupal/pathauto",
                "drupal/recaptcha_v3",
                "drupal/redirect",
                "drupal/restui",
                "drupal/sam",
                "drupal/schema_metatag",
                "drupal/schemata",
                "drupal/schemata_json_schema",
                "drupal/seckit",
                "drupal/security_review",
                "drupal/shield",
                "drupal/simple_oauth",
                "drupal/smart_trim",
                "drupal/tagify",
                "drupal/token",
                "drupal/token_filter",
                "drupal/tracker",
                "drupal/user_redirect",
                "drupal/view_password",
                "drupal/views_bulk_edit",
                "drupal/views_bulk_operations",
                "drupal/webform",
                "drupal/xmlsitemap",
                "drupal/yoast_seo"
            ]
        }
    }
}
